                    "label_for_charts": "stem Jaro-Winkler >= 0.95, qualifiers equal",
                    "m_probability": 0.043526002181,
                    "u_probability": 7.395538e-05,
                    "fix_m_probability": false,
                    "fix_u_probability": false
                },
                {
                    "sql_condition": "jaro_winkler_similarity(stem_l, stem_r) >= 0.88 AND quals_l = quals_r",
                    "label_for_charts": "stem Jaro-Winkler >= 0.88, qualifiers equal",
                    "m_probability": 0.04538216902,
                    "u_probability": 0.000455544599,
                    "fix_m_probability": false,
                    "fix_u_probability": false
                },
                {
                    "sql_condition": "jaro_winkler_similarity(stem_l, stem_r) >= 0.8 AND quals_l = quals_r",
                    "label_for_charts": "stem Jaro-Winkler >= 0.8, qualifiers equal",
                    "m_probability": 0.129584643096,
                    "u_probability": 0.003146698714,
                    "fix_m_probability": false,
                    "fix_u_probability": false
                },
                {
