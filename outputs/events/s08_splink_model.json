    "blocking_rules_to_generate_predictions": [
        {
            "blocking_rule": "l.\"name_norm\" = r.\"name_norm\"",
            "sql_dialect": "duckdb"
        },
        {
            "blocking_rule": "l.\"alias_norm\" = r.\"alias_norm\"",
            "sql_dialect": "duckdb"
        },
        {
            "blocking_rule": "l.\"stem\" = r.\"stem\"",
            "sql_dialect": "duckdb"
        },
        {
            "blocking_rule": "substr(l.name_norm, 1, 3) = substr(r.name_norm, 1, 3)",
            "sql_dialect": "duckdb"
        },
        {
            "blocking_rule": "jaro_winkler_similarity(l.name_norm, r.name_norm) >= 0.80",
            "sql_dialect": "duckdb"
        },
        {
            "blocking_rule": "jaro_winkler_similarity(l.stem, r.stem) >= 0.80",
            "sql_dialect": "duckdb"
        }
    ],
    "comparisons": [
        {
